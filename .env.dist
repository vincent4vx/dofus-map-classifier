# Copy to .env and fill values (read by docker compose)
OPENAI_API_KEY=
OPENAI_MODEL=luna
# Host path of the Dofus Retro client (./var/dofus for the one downloaded by "make client")
DOFUS_CLIENT_DIR=../arakneweb/Dofus
# Host path of the lang swf files (maps_{lang}_{version}.swf), and lang to use
DOFUS_LANG_DIR=../arakneweb/lang/swf
DOFUS_LANG=en
