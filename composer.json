{
    "name": "arakne/map-classifier",
    "description": "Automatic classification of Dofus Retro maps using OpenAI vision models",
    "type": "project",
    "license": "LGPL-3.0-or-later",
    "require": {
        "php": "~8.4",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-zlib": "*",
        "arakne/php-map-parser": "~0.1",
        "symfony/console": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/mime": "^8.0"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": { "MapClassifier\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "MapClassifier\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
